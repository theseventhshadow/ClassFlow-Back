# =============================================================
# Variables de entorno para ClassFlow Backend
# Copiar este archivo como .env y completar los valores reales
# =============================================================

# --- ms-auth: JWT ---
# Clave secreta para firmar tokens JWT. Generar con: openssl rand -hex 32
# No hay valor por defecto: ms-auth y docker-compose fallan al arrancar si falta.
JWT_SECRET=cambiar_por_una_clave_aleatoria_de_32_bytes
JWT_EXPIRATION=86400000
# Clave compartida solo entre ms-auth y ms-notification, para la unica llamada de
# servicio a servicio que existe (correo de recuperacion de contrasena). Generar con:
# openssl rand -hex 32
INTERNAL_API_KEY=cambiar_por_una_clave_aleatoria_de_32_bytes

# --- ms-notification: Correo SMTP (Brevo) ---
# Generar una SMTP key en https://app.brevo.com/settings/keys/smtp
# MAIL_USERNAME es el "Login" que muestra Brevo en esa misma pantalla (no tu email de cuenta),
# MAIL_PASSWORD es la SMTP key generada (no tu contraseña de Brevo).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=tu_login_smtp_de_brevo
MAIL_PASSWORD=tu_smtp_key_de_brevo
# Remitente verificado en Brevo (Settings > Senders, Domains & Dedicated IPs > Senders).
# No puede ser el MAIL_USERNAME de arriba: Brevo exige un remitente verificado aparte.
MAIL_FROM=tu_remitente_verificado@ejemplo.com

# --- GlitchTip: error tracking self-hospedado (http://localhost:8000) ---
# Clave aleatoria para la app de GlitchTip. Generar con: openssl rand -hex 32
GLITCHTIP_SECRET_KEY=cambiar_por_una_clave_aleatoria
# DSN del proyecto en GlitchTip. Queda vacio hasta crear una cuenta/proyecto en la UI
# (primer arranque: entrar a http://localhost:8000, crear cuenta, crear proyecto,
# copiar el DSN desde Settings > Client Keys). Con SENTRY_DSN vacio, el SDK no hace nada.
SENTRY_DSN=

# --- Microsoft Entra ID (los perfiles docker,entra son predeterminados en Compose) ---
# Issuer OIDC del tenant de Microsoft Entra.
# Issuer v1: la app de la API emite tokens v1 (requestedAccessTokenVersion sin definir).
# Si se cambia el manifiesto a v2, volver a https://login.microsoftonline.com/<TENANT_ID>/v2.0
ENTRA_ISSUER_URI=https://sts.windows.net/981c9c3d-2cb3-493c-8b5e-bcf013a445e3/
# Application ID URI o client ID configurado como audience de la API.
ENTRA_API_AUDIENCE=api://d3ec09df-b3b2-420c-b0dc-8b5534f58462
# Para volver explícitamente al modo local, sobrescribir los perfiles en el entorno.
# GATEWAY_SPRING_PROFILES_ACTIVE=docker
# BFF_SPRING_PROFILES_ACTIVE=docker
# MS_AUTH_SPRING_PROFILES_ACTIVE=docker
